    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT \n    email_usuario,\n    nombre_usuario,\n    ROUND(100.0 * SUM(\n        CASE \n            WHEN cumplido = 'Sí' THEN 1.0 \n            WHEN cumplido = 'Parcial' THEN 0.5 \n            ELSE 0.0 \n        END\n    ) / COUNT(*), 1) AS porcentaje_cumplimiento\nFROM habitos_registrados\nWHERE email_usuario = '{{ $json.email_usuario }}'\n  AND fecha_registro >= DATE_TRUNC('month', CURRENT_DATE)\nGROUP BY email_usuario, nombre_usuario;\n",
        "options": {}
      },
